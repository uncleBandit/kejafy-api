# ---------------------------------------------------------------------------
# Kejafy API — local development environment
#
#   cp .env.example .env
#   docker compose up -d          # Postgres on 5433, Redis on 6379
#   then Run → "KejaFy (local)" in VS Code, or:  set -a; . ./.env; ./mvnw spring-boot:run
#
# Used by both docker-compose.yml (POSTGRES_DB/USER/PASSWORD, REDIS_PASSWORD)
# and the app itself. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database: PostgreSQL (docker-compose publishes it on 5433) ------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=kejafy
POSTGRES_USER=kejafy
POSTGRES_PASSWORD=kejafy_dev_password

# --- Redis -----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=kejafy_dev_redis

# --- Frontend --------------------------------------------------------------
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_BASE_URL=http://localhost:5173
SWAGGER_UI_ENABLED=true
SPRING_JPA_SHOW_SQL=true

# --- Google OAuth2 ---------------------------------------------------------
# Google Cloud console → Credentials → OAuth client (Web application).
# Authorised redirect URI: http://localhost:8080/login/oauth2/code/google
# Must not be empty or the app will not start; the placeholders below let it
# boot, but "Sign in with Google" only works with real values.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# --- M-Pesa (Daraja sandbox) -----------------------------------------------
# developer.safaricom.co.ke → My Apps. Sandbox shortcode is 174379.
# The callback must be public HTTPS: tunnel localhost:8080 with
# ngrok/cloudflared and put that URL here.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-tunnel.example.com/api/v1/payments/mpesa/callback

# --- Stripe (test mode) ----------------------------------------------------
# dashboard.stripe.com → Developers → API keys (test mode).
# Webhook secret: `stripe listen --forward-to localhost:8080/api/v1/payments/stripe/webhook`
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Subscription pricing (optional; these are the defaults) ---------------
SUBSCRIPTION_PRICE_MONTHLY=999
SUBSCRIPTION_PRICE_YEARLY=9999
SUBSCRIPTION_CURRENCY=KES
