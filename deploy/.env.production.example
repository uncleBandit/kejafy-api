# ---------------------------------------------------------------------------
# Kejafy — production .env for compose.prod.yaml, kept at /opt/kejafy/.env on
# the server. Never commit the real one.
#
#   openssl rand -hex 24     # for each password below
# ---------------------------------------------------------------------------

IMAGE_TAG=latest
SITE_ADDRESS=api.kejafy.com
ACME_EMAIL=admin@unclecanvas.com

POSTGRES_DB=kejafy
POSTGRES_USER=kejafy
POSTGRES_PASSWORD=

REDIS_PASSWORD=

APP_CORS_ALLOWED_ORIGINS=https://kejafy.com
APP_FRONTEND_BASE_URL=https://kejafy.com

# Google console → authorised redirect URI:
#   https://<SITE_ADDRESS>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.kejafy.com/api/v1/payments/mpesa/callback

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

SUBSCRIPTION_PRICE_MONTHLY=999
SUBSCRIPTION_PRICE_YEARLY=9999
SUBSCRIPTION_CURRENCY=KES
