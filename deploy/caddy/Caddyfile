{
	email {$ACME_EMAIL}
}

# SITE_ADDRESS: api.kejafy.com for automatic HTTPS, or :80 to try it locally.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Caddy sends X-Forwarded-Proto/Host; Spring trusts them
	# (SERVER_FORWARD_HEADERS_STRATEGY=framework).
	reverse_proxy app:8080
}
